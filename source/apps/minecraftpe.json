			},
			{
				"type": "extractFile",
				"file": "/minecraftpe.rar",
				"input": "",
				"output": "/3ds"
			},
			{
				"type": "deleteFile",
				"file": "/minecraftcpp.cia"
			},
			{
				"type": "deleteFile",
				"file": "/minecraftpe.rar"
			}
		]
